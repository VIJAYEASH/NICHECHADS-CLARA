{
  "manifest_version": 3,

  "name": "CLARA - AI Phishing Protection",

  "version": "1.0.0",

  "description": "CLARA detects suspicious and phishing websites using AI and security analysis.",

  "permissions": [
    "activeTab",
    "tabs",
    "storage"
  ],

  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "http://*/*",
    "https://*/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "clara-logo.png"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "CLARA"
  }
}